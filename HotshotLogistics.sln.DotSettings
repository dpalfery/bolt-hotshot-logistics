<wpf:ResourceDictionary xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:s="clr-namespace:System;assembly=mscorlib"
                        xmlns:ss="clr-namespace:JetBrains.Application.Settings.Storage.Shared;assembly=JetBrains.Platform.ComponentModel">
    <s:Boolean x:Key="/Default/UnitTesting/UseVsTestRunner/@EntryValue">true</s:Boolean>
    <s:String x:Key="/Default/UnitTesting/PlatformType/@EntryValue">Arm64</s:String>
    <s:String x:Key="/Default/UnitTesting/DefaultUnitTestSessionSettings/PlatformType/@EntryValue">Arm64</s:String>
    <s:String x:Key="/Default/UnitTestingSettings/PlatformType/@EntryValue">Arm64</s:String>
    <s:String x:Key="/Default/UnitTestingSettings/DefaultUnitTestSessionSettings/PlatformType/@EntryValue">Arm64</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedAutoPropertyAccessor_002EGlobal/@EntryValue">DO_NOT_SHOW</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedAutoPropertyAccessor_002ELocal/@EntryValue">DO_NOT_SHOW</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=CollectionNeverUpdated_002EGlobal/@EntryValue">DO_NOT_SHOW</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=CollectionNeverUpdated_002ELocal/@EntryValue">DO_NOT_SHOW</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedMember_002EGlobal/@EntryValue">DO_NOT_SHOW</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedMemberInSuper_002EGlobal/@EntryValue">DO_NOT_SHOW</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UseCollectionExpression/@EntryValue">DO_NOT_SHOW</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedMember_002ELocal/@EntryValue">WARNING</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=UnusedParameter_002ELocal/@EntryValue">WARNING</s:String>
</wpf:ResourceDictionary>
