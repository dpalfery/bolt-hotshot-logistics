<Project>
  <!--
    Shared MSBuild defaults for every .csproj under this repository.
    Code-style IDE rules (e.g. IDE0005 unused usings) only execute on build when
    EnforceCodeStyleInBuild is true AND the rule severity in .editorconfig is
    warning or error (suggestion/silent rules stay IDE-only).
  -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!--
      IDE0005 (Remove unnecessary usings) only runs during build when XML doc
      generation is enabled: https://github.com/dotnet/roslyn/issues/41640
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);IDE0005;IDE1006</WarningsAsErrors>
    <!--
      XML docs are required only so IDE0005 can fire on build. Missing comments
      (CS1591) stay suppressed until a full documentation pass is intentional.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PlatformTarget Condition="$([MSBuild]::IsOSPlatform('OSX'))">ARM64</PlatformTarget>
  </PropertyGroup>
</Project>
