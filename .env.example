# Hotshot Logistics Environment Variables
# Copy this file to .env and fill in your actual values
#
# SECURITY NOTICE: All environment variables below are REQUIRED
# No fallback passwords are provided to ensure secure configuration

# Database Configuration
# SQL Server SA password for local development (Docker Compose)
# REQUIRED: Must be a strong password meeting SQL Server requirements
SQL_SA_PASSWORD=

# Test Database Password
# REQUIRED: Password for test database connections
TEST_DB_PASSWORD=

# Azure Configuration (for production deployments)
# AZURE_CLIENT_ID=your-azure-client-id
# AZURE_CLIENT_SECRET=your-azure-client-secret
# AZURE_TENANT_ID=your-azure-tenant-id

# Database Connection String (alternative to individual settings)
# CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=your-server;Database=your-db;User Id=your-user;Password=your-password;

# External Service API Keys (for production)
# STRIPE_SECRET_KEY=sk_test_...
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# SENDGRID_API_KEY=your-sendgrid-key
# AZURE_MAPS_KEY=your-azure-maps-key